# ================================================================
# KOBONG VPN BOT — Environment Configuration
# Copy this file to .env and fill in real values. NEVER commit .env
# ================================================================

# ---------------- Telegram Bot ----------------
# Get token from @BotFather
BOT_TOKEN=1234567890:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Bot username (without @) — used in payment redirect URLs
BOT_USERNAME=KobongVpnBot

# Comma-separated Telegram user IDs of super admins (get from @userinfobot)
SUPER_ADMIN_IDS=123456789

# Optional: chat ID to receive system notifications (errors, new orders)
NOTIFY_CHAT_ID=

# ---------------- Encryption ----------------
# 32-byte URL-safe base64 key used to encrypt VPS credentials at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# WARNING: If you lose this key, all stored VPS passwords are unrecoverable.
FERNET_KEY=CHANGE_ME_TO_A_REAL_FERNET_KEY

# ---------------- Database ----------------
# SQLite (default, good for < 5000 users). Path is relative to bot working dir.
DATABASE_URL=sqlite+aiosqlite:///data/kobong.db

# For Postgres, use:
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/kobong

# ---------------- Pakasir Payment Gateway ----------------
# Register at https://app.pakasir.com and create a project.
PAKASIR_SLUG=your-project-slug
PAKASIR_API_KEY=your-api-key

# Webhook secret for verifying Pakasir callbacks (set the same value in Pakasir dashboard).
PAKASIR_WEBHOOK_SECRET=random-long-string

# Public URL of this bot's webhook endpoint (for Pakasir to POST payment updates).
# Example: https://bot.example.com/webhook/pakasir
PUBLIC_WEBHOOK_URL=https://your-domain.com

# ---------------- Web server (for webhooks) ----------------
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080

# ---------------- Behavior ----------------
# Default currency label (display only)
CURRENCY=Rp

# Default price per account (Rupiah) — can be overridden per product in DB
DEFAULT_PRICE_SSH=5000
DEFAULT_PRICE_XRAY=8000
DEFAULT_PRICE_ZIVPN=10000

# Default account duration (days)
DEFAULT_DURATION_DAYS=30

# Maximum concurrent SSH sessions per bot to prevent VPS overload
SSH_POOL_SIZE=10

# Log level: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
